{
  "name": "interview-coder",
  "version": "1.8.0",
  "main": "./dist-electron/main.js",
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "vite",
    "build": "npm run clean && npm run typecheck && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,electron,tests}/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm rebuild sharp",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:run": "cross-env NODE_ENV=development electron .",
    "electron:dev": "npm run electron:compile && concurrently -k -s first -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5180 && npm run electron:run\"",
    "electron:build": "tsc -p electron/tsconfig.json && cross-env NODE_ENV=production electron .",
    "app:dev": "npm run electron:dev",
    "app:build": "npm run build && electron-builder",
    "watch": "tsc -p electron/tsconfig.json --watch",
    "start": "npm run app:dev",
    "dist": "npm run app:build"
  },
  "build": {
    "appId": "com.notes.desktop",
    "productName": "Notes",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!release/**",
      "!release-*/**",
      "!node_modules/react-icons/**",
      "!node_modules/lucide-react/**",
      "!node_modules/@radix-ui/**",
      "!node_modules/react-syntax-highlighter/**",
      "!node_modules/react-code-blocks/**",
      "!node_modules/react-query/**",
      "!node_modules/@emotion/**",
      "!node_modules/@babel/**",
      "!node_modules/refractor/**",
      "!node_modules/highlight.js/**",
      "!node_modules/lowlight/**",
      "!node_modules/prismjs/**",
      "!node_modules/@xenova/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-common/**",
      "!node_modules/protobufjs/**",
      "!node_modules/@protobufjs/**",
      "!node_modules/onnx-proto/**",
      "!node_modules/@huggingface/**",
      "!**/node_modules/**/*.{md,markdown,map,ts,tsx,flow,tsbuildinfo}",
      "!**/node_modules/**/{test,tests,__tests__,example,examples,doc,docs,demo,.github,.idea}/**",
      "!**/node_modules/**/{LICENSE,license,LICENCE,AUTHORS,CHANGELOG,CONTRIBUTING}*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/mac/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true
      },
      "files": [
        "!release-*/**",
        "!release/**",
        "!node_modules/@img/sharp-win32-*/**",
        "!node_modules/@img/sharp-linux*/**",
        "!node_modules/@img/sharp-libvips-linux*/**",
        "!node_modules/@img/sharp-wasm32/**"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "files": [
        "!release-*/**",
        "!release/**",
        "!node_modules/@img/sharp-darwin-*/**",
        "!node_modules/@img/sharp-libvips-darwin-*/**",
        "!node_modules/@img/sharp-linux*/**",
        "!node_modules/@img/sharp-libvips-linux*/**",
        "!node_modules/@img/sharp-wasm32/**"
      ],
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/png/",
      "category": "Office",
      "files": [
        "!release-*/**",
        "!release/**",
        "!node_modules/@img/sharp-win32-*/**",
        "!node_modules/@img/sharp-darwin-*/**",
        "!node_modules/@img/sharp-libvips-darwin-*/**",
        "!node_modules/@img/sharp-wasm32/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notes",
      "allowElevation": false,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BitecodesHub",
        "repo": "IA-Core"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/screenshot-desktop/**"
    ],
    "npmRebuild": false,
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/color": "^4.2.0",
    "@types/diff": "^6.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/screenshot-desktop": "^1.12.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "form-data": "^4.0.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-query": "^3.39.3",
    "react-syntax-highlighter": "^15.6.6",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.4",
    "uuid": "^11.0.3"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
