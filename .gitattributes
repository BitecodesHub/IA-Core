# Normalise line endings so a Windows checkout (Git for Windows defaults to
# core.autocrlf=true) does not rewrite every source file to CRLF and make the
# whole tree look modified against Prettier's LF setting.
* text=auto eol=lf

# Windows-native files that must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.dmg binary
*.exe binary
*.dll binary
*.node binary
*.zip binary
*.bin binary

